{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "COSMOS_DB_ENDPOINT": "https://<your-account>.documents.azure.com:443/",
    "COSMOS_DB_KEY": "<your-cosmos-db-primary-key>",
    "COSMOS_DB_DATABASE": "KineticHR",
    "BLOB_STORAGE_CONNECTION_STRING": "DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net",
    "BLOB_CONTAINER_TENANTS": "tenants",
    "JWT_SECRET": "your-super-secret-enterprise-jwt-key-256bit-min",
    "JWT_EXPIRATION": "7d"
  },
  "Host": {
    "CORS": "*",
    "CORSCredentials": false
  }
}
