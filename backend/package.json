{
  "name": "kinetic-hr-backend",
  "version": "1.0.0",
  "description": "Kinetic HR Cloud Multi-Tenant Azure Functions Backend",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "dev": "npm run build && node dist/src/dev-server.js",
    "start": "npm run build && node dist/src/dev-server.js",
    "seed": "npm run build && node dist/src/scripts/seed.js",
    "start:func": "func start",
    "test": "echo \"No test specified\" && exit 0"
  },
  "dependencies": {
    "@azure/cosmos": "^4.2.0",
    "@azure/functions": "^4.6.0",
    "@azure/storage-blob": "^12.26.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "main": "dist/src/index.js"
}
